# Copy to `.dev.vars` (gitignored) for local development.
#
# `next dev` reads bindings and vars through @opennextjs/cloudflare's
# getPlatformProxy, which layers `.dev.vars` over the `vars` block in
# wrangler.jsonc. Without this file BETTER_AUTH_URL falls back to the
# production value there (https://betabook.ca), so every verification and
# password-reset link generated locally points at the deployed site.

BETTER_AUTH_URL=http://localhost:3000

# Any non-empty string. Signs session cookies, so changing it invalidates
# existing local sessions — that's fine, just sign in again.
BETTER_AUTH_SECRET=dev-only-secret-change-me

# Leave this empty locally. lib/email.ts treats an empty key as "no Resend"
# and logs verification and reset links to the `next dev` console instead of
# sending real mail. Keep the line itself: `pnpm cf-typegen` derives
# CloudflareEnv partly from this file, and dropping it makes lib/email.ts's
# `env.RESEND_API_KEY` fail to typecheck.
RESEND_API_KEY=
