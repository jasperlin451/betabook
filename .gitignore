# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Glob rather than the bare `.dev.vars`: wrangler's `--env` flag selects
# `.dev.vars.<environment>` too, and those hold real secrets. This pair is
# what wrangler writes into a .gitignore itself.
.dev.vars*
!.dev.vars.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# plan-mode snapshots
.plans

# wrangler / cloudflare
.wrangler
.open-next
worker-configuration.d.ts

# seed data
climbs_data

# local Claude Code session/config data
.claude