{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "betabook",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "routes": [
    {
      "pattern": "betabook.ca",
      "custom_domain": true,
    },
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://betabook.ca",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "betabook-db",
      "database_id": "15af4a85-e36f-4cb6-a310-a0b2cdfe126e",
      "migrations_dir": "drizzle/migrations",
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
}
