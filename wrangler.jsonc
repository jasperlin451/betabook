{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "senderoni",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "routes": [
    {
      "pattern": "senderoni.cowsgomwoo.com",
      "custom_domain": true,
    },
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://senderoni.cowsgomwoo.com",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "senderoni-db",
      "database_id": "6fa2c847-efb1-4e96-bfd7-968dc82a80fd",
      "migrations_dir": "drizzle/migrations",
    },
  ],
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
}
