{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "senderoni",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "senderoni-db",
      // TODO: placeholder — run `pnpm wrangler d1 create senderoni-db` (requires Cloudflare auth)
      // and replace with the real database_id before deploying or running --remote commands.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle/migrations"
    }
  ]
}
